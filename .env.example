# Copia questo file in .env.local e compila con i dati del progetto Supabase
# (Project Settings → API). Senza questi valori gli account sono disattivati e il gioco resta solo locale.
#
# Usa SOLO la chiave "publishable" (o "anon"): è pensata per stare nel browser, la sicurezza la fanno
# le regole di accesso del database. NON mettere mai qui la chiave "secret" / "service_role".
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
